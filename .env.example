# PinDou 环境变量模板
# 用法：复制为 .env（.env 已在 .gitignore），填入真实 key
# 严禁 commit .env 文件

# =========================
# 当前生产 SSH（2026-09-18 完整迁移后）
# 资产与期限：07_ops/SERVER_ASSETS.md；私钥文件不入 Git
# =========================
PINDOU_PROD_SSH_HOST=36.139.201.94
PINDOU_PROD_SSH_USER=pindou
PINDOU_PROD_SSH_KEY_PATH=C:/Users/123/.ssh/pindou_mobilecloud_20260918_ed25519

# =========================
# 反代 API（图像通道，主）
# =========================
# 入口：https://gpt.xiaochisaascn.org/v1
# 可用模型：gpt-image-2 / gpt-5.x / codex-auto-review / my-gpt
XIAOCHI_GPT_BASE_URL=https://gpt.xiaochisaascn.org/v1
XIAOCHI_GPT_API_KEY=
XIAOCHI_GPT_PROMPT_VARIANT=prompt_a_current

# =========================
# 反代 API（文本通道）
# =========================
# 入口：https://api2.xiaochisaas.com
# 可用模型：claude-sonnet-4-6 / gemini-3.1-pro-* / gemini-3-pro-image
XIAOCHI_TEXT_BASE_URL=https://api2.xiaochisaas.com
XIAOCHI_TEXT_API_KEY=

# =========================
# 国产 provider（待补，ADR-005 备选 + 国产合规通道）
