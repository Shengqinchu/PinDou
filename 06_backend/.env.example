# PinDou backend environment template
# Copy to .env and fill real secrets locally. Never commit real .env files.

# Runtime
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=info
APP_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Storage
DATABASE_URL=sqlite:///./var/pindou.db
PINDOU_DATA_DIR=./var/data
PINDOU_UPLOAD_DIR=./var/data/uploads
PINDOU_PREVIEW_DIR=./var/data/previews
PINDOU_PATTERN_DIR=./var/data/patterns

# AI provider
XIAOCHI_GPT_BASE_URL=https://gpt.xiaochisaascn.org/v1
XIAOCHI_GPT_API_KEY=
XIAOCHI_TEXT_BASE_URL=https://api2.xiaochisaas.com
XIAOCHI_TEXT_API_KEY=

# WeChat Mini Program
WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=

# Security
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Provider health check
REVERSE_PROXY_HEALTH_URL=https://gpt.xiaochisaascn.org/v1/models
REVERSE_PROXY_CHECK_INTERVAL_SECONDS=300
REVERSE_PROXY_ALERT_AFTER_SECONDS=21600
