# PinDou backend environment template
# Copy to .env and fill real secrets locally. Never commit real .env files.

# Runtime
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=info
APP_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
MAX_REQUEST_BODY_BYTES=12582912

# Storage / database
DATABASE_URL=sqlite:///./var/pindou.db
# Production wxcloud MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/pindou?charset=utf8mb4
PINDOU_DATA_DIR=./var/data
PINDOU_UPLOAD_DIR=./var/data/uploads
PINDOU_PREVIEW_DIR=./var/data/previews
PINDOU_PATTERN_DIR=./var/data/patterns
PINDOU_THUMBNAIL_DIR=./var/data/thumbnails
STORAGE_BACKEND=local
# Production wxcloud COS example:
# STORAGE_BACKEND=cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-shanghai
# COS_PUBLIC_BASE_URL=

# AI provider
XIAOCHI_GPT_BASE_URL=https://gpt.xiaochisaascn.org/v1
XIAOCHI_GPT_API_KEY=
XIAOCHI_GPT_IMAGE_COST_CNY=0.0
XIAOCHI_GPT_PROMPT_VARIANT=prompt_a_current
ENABLE_AI_PREVIEW_WHITE_BG_AUTO_NOBEED=true
XIAOCHI_TEXT_BASE_URL=https://api2.xiaochisaas.com
XIAOCHI_TEXT_API_KEY=

# WeChat Mini Program
WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=

# Security
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
CUSTOMER_SERVICE_QR_URL=/static/assets/qr-placeholder.svg
CUSTOMER_SERVICE_WX_ID=pindou_cs_01

# Hupijiao payment QR provider
HUPIJIAO_APP_ID=
HUPIJIAO_APP_SECRET=
HUPIJIAO_WEBHOOK_SECRET=
HUPIJIAO_CALLBACK_URL=http://192.168.2.40:8000/api/v1/webhook/hupijiao
# wxcloud production example:
# HUPIJIAO_CALLBACK_URL=https://<wxcloud-default-domain>/api/v1/webhook/hupijiao
HUPIJIAO_API_BASE_URL=https://api.xunhupay.com

# Provider health check
REVERSE_PROXY_HEALTH_URL=https://gpt.xiaochisaascn.org/v1/models
REVERSE_PROXY_CHECK_INTERVAL_SECONDS=300
REVERSE_PROXY_ALERT_AFTER_SECONDS=21600
ENABLE_REVERSE_PROXY_HEALTH_MONITOR=true

# ADR-009 private asset retention
EXPIRED_ORIGINAL_RETENTION_DAYS=30
EXPIRED_ORIGINAL_DELETE_INTERVAL_SECONDS=86400
ENABLE_EXPIRED_ORIGINAL_DELETE_TASK=true
